<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, shrink-to-fit=9" />
  <meta name="description" content="barren" />
  <meta name="author" content="barren" />
  <title>Barren - Checkout</title>

  <link rel="icon" type="image/png" href="/images/fav.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com/" />
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet" />
  <link href="/vendor/unicons-2.0.1/css/unicons.css" rel="stylesheet" />
  <link href="/css/style.css" rel="stylesheet" />
  <link href="/css/responsive.css" rel="stylesheet" />
  <link href="/css/night-mode.css" rel="stylesheet" />

  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />
  <link href="/vendor/OwlCarousel/assets/owl.carousel.css" rel="stylesheet" />
  <link href="/vendor/OwlCarousel/assets/owl.theme.default.min.css" rel="stylesheet" />
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet" />
</head>

<body class="d-flex flex-column h-100">

  <!-- Header -->
  <header class="header">
    <div class="header-inner">
      <nav class="navbar navbar-expand-lg bg-barren barren-head navbar fixed-top justify-content-sm-start pt-0 pb-0">
        <div class="container">
          <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar">
            Menu
          </button>

          <a class="navbar-brand order-1 order-lg-0 ml-lg-0 ml-2" href="/">
            <div class="res-main-logo ml-auto">
              <img src="/images/logo-icon.svg" alt="" />
            </div>
            <div class="main-logo" id="logo">
              <img src="/images/logo.svg" alt="" />
              <img class="logo-inverse" src="/images/dark-logo.svg" alt="" />
            </div>
          </a>

          <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar">
            <div class="offcanvas-header">
              <div class="offcanvas-logo">
                <img src="/images/logo-icon.svg" alt="" />
              </div>
              <button type="button" class="close-btn" data-bs-dismiss="offcanvas">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
            <div class="offcanvas-body">
              <div class="offcanvas-top-area">
                <div class="create-bg">
                  <a href="/event/create" class="offcanvas-create-btn">
                    <i class="fa-solid fa-calendar-days"></i>
                    <span>Create Event</span>
                  </a>
                </div>
              </div>
              <ul class="navbar-nav justify-content-end flex-grow-1 pe_5">
                <li class="nav-item"><a class="nav-link active" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/events/explore">Explore Events</a></li>
              </ul>
            </div>
          </div>

          <div class="auth-section d-flex align-items-center ml-auto">
            <% if (!user) { %>
            <div id="auth-logged-out" class="d-flex align-items-center gap-3">
              <a href="/auth/login" class="btn btn-outline-light text-success">Sign In</a>
              <a href="/auth/register" class="create-btn btn-hover px-4">Sign Up</a>
            </div>
            <% } else { %>
            <div id="auth-logged-in" class="dropdown">
              <a href="#" class="d-flex align-items-center ml-auto text-white text-decoration-none" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="/images/profile-imgs/img-13.jpg" alt="User" class="rounded-circle me-2" width="40" height="40" />
                <span class="fw-medium"><%= user.firstName %> <%= user.lastName %></span>
                <i class="fas fa-caret-down ms-2"></i>
              </a>
              <ul class="dropdown-menu dropdown-menu-end p-3 shadow-lg border-0">
                <li class="text-center mb-3">
                  <img src="/images/profile-imgs/img-13.jpg" class="rounded-circle mb-3" width="80" height="80" alt="User" />
                  <h6 class="mb-1 fw-bold"><%= user.firstName %> <%= user.lastName %></h6>
                  <p class="text-muted small mb-0"><%= user.email %></p>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li><a href="/my_invoices" class="dropdown-item py-2 rounded">My Invoices</a></li>
                <li>
                  <a href="#" class="dropdown-item py-2 rounded text-danger fw-medium" onclick="signOutUser(); return false;">
                    Sign Out
                  </a>
                </li>
              </ul>
            </div>
            <% } %>
          </div>
        </div>
      </nav>
      <div class="overlay"></div>
    </div>
  </header>

  <div class="wrapper">
    <div class="breadcrumb-block">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 col-md-10">
            <div class="barren-breadcrumb">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/">Home</a></li>
                  <li class="breadcrumb-item"><a href="/events/explore">Explore Events</a></li>
                  <li class="breadcrumb-item active" aria-current="page">Checkout</li>
                </ol>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="event-dt-block p-80">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 col-md-12">
            <div class="main-title checkout-title">
              <h3>Order Confirmation</h3>
            </div>
          </div>

          <div class="col-xl-8 col-lg-12 col-md-12">
            <div class="checkout-block">
              <div class="main-card">
                <div class="bp-title"><h4>Billing information</h4></div>
                <div class="bp-content bp-form">
                  <div class="row">
                    <div class="col-lg-6 col-md-12">
                      <div class="form-group mt-4">
                        <label class="form-label">First Name*</label>
                        <input class="form-control h_50" type="text" id="first_name" required />
                      </div>
                    </div>
                    <div class="col-lg-6 col-md-12">
                      <div class="form-group mt-4">
                        <label class="form-label">Last Name*</label>
                        <input class="form-control h_50" type="text" id="last_name" required />
                      </div>
                    </div>
                    <div class="col-lg-6 col-md-12">
                      <div class="form-group mt-4">
                        <label class="form-label">Email*</label>
                        <input class="form-control h_50" type="email" id="email" required />
                      </div>
                    </div>
                    <div class="col-lg-6 col-md-12">
                      <div class="form-group mt-4">
                        <label class="form-label">Address (optional)</label>
                        <input class="form-control h_50" type="text" id="address" />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-xl-4 col-lg-12 col-md-12">
            <div class="main-card order-summary">
              <div class="bp-title"><h4>Order Summary</h4></div>
              <div class="order-summary-content p_30">
                <div class="event-order-dt">
                  <div class="event-thumbnail-img">
                    <img src="" alt="" id="order-event-img" />
                  </div>
                  <div class="event-order-dt-content">
                    <h5 id="order-event-name"></h5>
                    <span id="order-event-date"></span>
                    <div class="category-type" id="order-event-category"></div>
                  </div>
                </div>

                <div class="order-total-block">
                  <div class="order-total-dt">
                    <div class="order-text">Total Tickets</div>
                    <div class="order-number" id="order-ticket-count">1</div>
                  </div>
                  <div class="order-total-dt">
                    <div class="order-text">Sub Total</div>
                    <div class="order-number" id="order-sub-total">₦0.00</div>
                  </div>
                  <div class="divider-line"></div>
                  <div class="order-total-dt">
                    <div class="order-text">Total</div>
                    <div class="order-number ttl-clr">
                      ₦<span id="order-total">0.00</span>
                    </div>
                  </div>
                </div>

                <div class="confirmation-btn">
                  <button class="main-btn btn-hover h_50 w-100 mt-5" type="button" onclick="payWithPaystack()">
                    Confirm & Pay
                  </button>
                  <span>Price is inclusive of all applicable fees</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer mt-auto">
    <div class="footer-top">
      <div class="container">
        <div class="row">
          <div class="col-lg-4 col-md-6">
            <div class="footer-content">
              <h4>Company</h4>
              <ul class="footer-link-list">
                <li><a href="help_center.html" class="footer-link">Help Center</a></li>
                <li><a href="faq.html" class="footer-link">FAQ</a></li>
                <li><a href="contact_us.html" class="footer-link">Contact Us</a></li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="footer-content">
              <h4>Useful Links</h4>
              <ul class="footer-link-list">
                <li><a href="/event/create" class="footer-link">Create Event</a></li>
                <li><a href="privacy_policy.html" class="footer-link">Privacy Policy</a></li>
                <li><a href="term_and_conditions.html" class="footer-link">Terms & Conditions</a></li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="footer-content">
              <h4>Follow Us</h4>
              <ul class="social-links">
                <li><a href="#" class="social-link"><i class="fab fa-facebook-square"></i></a></li>
                <li><a href="#" class="social-link"><i class="fab fa-instagram"></i></a></li>
                <li><a href="#" class="social-link"><i class="fab fa-twitter"></i></a></li>
                <li><a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a></li>
                <li><a href="#" class="social-link"><i class="fab fa-youtube"></i></a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="footer-copyright-text">
              <p class="mb-0">© 2024, <strong>Barren</strong>. All rights reserved.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <span id="userId" style="display:none"><%= user?._id || '' %></span>

  <script src="/js/jquery.min.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/OwlCarousel/owl.carousel.min.js"></script>
  <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
  <script src="/js/custom.js"></script>
  <script src="/js/night-mode.js"></script>

  <script src="https://js.paystack.co/v1/inline.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const eventDetails = JSON.parse(localStorage.getItem("bookingEvent") || "{}");

      if (!eventDetails.id) {
        alert("No event details found. Redirecting...");
        window.location.href = "/";
        return;
      }

      document.getElementById("order-event-img").src = eventDetails.image || "/images/placeholder.jpg";
      document.getElementById("order-event-name").textContent = eventDetails.name || "Event";
      document.getElementById("order-event-date").textContent = `${eventDetails.date || ''} ${eventDetails.time || ''}`.trim() || "N/A";
      document.getElementById("order-event-category").textContent = eventDetails.category || "Event";
      document.getElementById("order-ticket-count").textContent = eventDetails.quantity || 1;
      document.getElementById("order-sub-total").textContent = `₦${Number(eventDetails.totalPrice || 0).toLocaleString()}`;
      document.getElementById("order-total").textContent = Number(eventDetails.totalPrice || 0).toLocaleString();
    });


  function payWithPaystack() {
    const eventDetails = JSON.parse(localStorage.getItem("bookingEvent") || "{}");

    const firstName = document.getElementById("first_name").value.trim();
    const lastName  = document.getElementById("last_name").value.trim();
    const email     = document.getElementById("email").value.trim();

    if (!firstName || !lastName || !email) {
      alert("Please fill in all required fields (First Name, Last Name, Email).");
      return;
    }

    if (!eventDetails.id) {
      alert("Event information is missing. Please try again.");
      return;
    }

    const loader = document.querySelector(".overlay-loader") || document.body;

    let handler = PaystackPop.setup({
      key: "pk_test_ea580a8223e37698b31632107c8732b14b99fd84",
      email: email,
      amount: (Number(eventDetails.totalPrice || 0) + 550) * 100,
      currency: "NGN",
      metadata: {
        userId: document.getElementById("userId").textContent,
        eventId: eventDetails.id,
        quantity: eventDetails.quantity || 1,
        eventName: eventDetails.name || "Event",
        custom_fields: [
          {
            display_name: "Full Name",
            variable_name: "customer_name",
            value: `${firstName} ${lastName}`
          }
        ]
      },
      callback: function (response) {
        // This must be a plain function (not async)
        console.log("Payment successful - Reference:", response.reference);

        // Show loading state
        loader.classList?.add("active") || (document.body.style.opacity = "0.6");

        // Redirect immediately – backend fallback will handle transaction creation
        window.location.assign(`/booking_confirmed?reference=${response.reference}`);
      },
      onClose: function () {
        alert("Payment window closed. No payment was completed.");
      }
    });

    handler.openIframe();
  }

  </script>

  <div class="overlay-loader"><div class="loader-spinner"></div></div>

  <script>
    function signOutUser() {
      document.cookie = "barren-token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
      window.location.href = "/auth/login";
    }
  </script>
</body>
</html>