  <script src="/js/jquery.min.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/OwlCarousel/owl.carousel.min.js"></script>
  <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
  <script src="/js/custom.js"></script>
  <script src="/js/night-mode.js"></script>

  <script>
  async function loadBookingPage() {
    const params = new URLSearchParams(window.location.search);
    const reference = params.get("reference");

    if (!reference) {
      document.getElementById("eventName").innerText = "Error";
      document.getElementById("eventDateTime").innerText = "No reference found in URL";
      document.getElementById("viewTicket").style.display = "none";
      alert("No payment reference found.");
      return;
    }

    try {
      const res = await fetch(`/api/payment/booking-details?reference=${encodeURIComponent(reference)}`);

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error || `Server error (${res.status})`);
      }

      const data = await res.json();

      if (!data.success) {
        throw new Error(data.message || "Could not load booking");
      }

      const { transaction, user, event, invoice } = data;

      // ── Event Name ────────────────────────────────────────────────
      document.getElementById("eventName").innerText =
        event?.eventName || transaction?.eventDetails?.name || "Event";

      // ── Buyer Name ────────────────────────────────────────────────
      document.getElementById("buyerName").innerText =
        user ? `${user.firstName || ''} ${user.lastName || ''}`.trim() || user.email || "Guest"
             : "Guest";

      // ── Ticket Count ──────────────────────────────────────────────
      document.getElementById("ticketCount").innerText = transaction?.eventDetails?.quantity || "1";

      // ── Total Price ───────────────────────────────────────────────
      document.getElementById("totalPrice").innerText =
        transaction?.amount ? `₦${Number(transaction.amount).toLocaleString()}` : "₦0.00";

      // ── Event Image ───────────────────────────────────────────────
      const img = document.getElementById("eventImage");
      img.src = event?.eventBanner || transaction?.eventDetails?.image || "/images/placeholder.jpg";
      img.onerror = () => { img.src = "/images/placeholder.jpg"; };

      // ── View Ticket / Invoice Button ──────────────────────────────
      const viewBtn = document.getElementById("viewTicket");
      if (invoice?._id) {
        viewBtn.href = `/invoice/${invoice._id}`;
      } else {
        viewBtn.textContent = "Invoice / Ticket not available yet";
        viewBtn.style.opacity = "0.6";
      }

      // ── Formatted Date & Time ─────────────────────────────────────
      const datePart = event?.eventDate || transaction?.eventDetails?.date || '';
      const timePart = event?.eventTime || transaction?.eventDetails?.time || '';

      let formattedDateTime = 'Date & Time: N/A';

      if (datePart || timePart) {
        // If date and time are the same string → treat as one value
        if (datePart === timePart && datePart) {
          formattedDateTime = formatDateTime(datePart);
        } else {
          const dateStr = datePart ? formatDate(datePart) : '';
          const timeStr = timePart ? formatTime(timePart) : '';

          if (dateStr && timeStr) {
            formattedDateTime = `${dateStr} • ${timeStr}`;
          } else if (dateStr) {
            formattedDateTime = dateStr;
          } else if (timeStr) {
            formattedDateTime = timeStr;
          }
        }
      }

      document.getElementById("eventDateTime").innerText = formattedDateTime;

    } catch (err) {
      console.error("Booking load error:", err);
      document.getElementById("eventName").innerText = "Error Loading Booking";
      document.getElementById("eventDateTime").innerText = err.message;
      document.getElementById("viewTicket").style.display = "none";
      alert("Failed to load booking details: " + err.message);
    }
  }

  // ── Helper functions for nice formatting ────────────────────────────────
  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr;

      return d.toLocaleDateString('en-GB', {
        weekday: 'short',     // Sat
        day: 'numeric',       // 28
        month: 'short',       // Feb
        year: 'numeric'       // 2026
      });
      // → "Sat 28 Feb 2026"
    } catch {
      return dateStr;
    }
  }

  function formatTime(timeStr) {
    if (!timeStr) return '';
    try {
      let t = timeStr.trim();

      // Already has AM/PM → keep as is
      if (/[ap]m/i.test(t)) return t;

      // Try to parse HH:mm or H:mm
      const parts = t.split(':');
      if (parts.length >= 2) {
        let hours = parseInt(parts[0], 10);
        let minutes = parseInt(parts[1], 10) || 0;

        if (!isNaN(hours) && !isNaN(minutes)) {
          return new Date(2000, 0, 1, hours, minutes)
            .toLocaleTimeString('en-US', {
              hour: 'numeric',
              minute: '2-digit',
              hour12: true
            });
          // → "3:30 AM" or "3:30 PM"
        }
      }

      return t; // fallback
    } catch {
      return timeStr;
    }
  }

  function formatDateTime(isoOrString) {
    try {
      const d = new Date(isoOrString);
      if (isNaN(d.getTime())) return isoOrString;

      const date = d.toLocaleDateString('en-GB', {
        weekday: 'short',
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
      const time = d.toLocaleTimeString('en-US', {
        hour: 'numeric',
        minute: '2-digit',
        hour12: true
      });

      return `${date} • ${time}`;
    } catch {
      return isoOrString;
    }
  }

  // Start loading when page is ready
  loadBookingPage();
</script>

  <script>
    function signOutUser() {
      document.cookie = "barren-token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
      window.location.href = "/auth/login";
    }
  </script>
</body>
